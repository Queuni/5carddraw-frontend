# =====================================
# Unity WebGL – Safe Production Config
# =====================================

# Do NOT disable WordPress rewrites globally
# (Safe to omit RewriteEngine Off)

# ===========================
# Correct MIME Types
# ===========================

AddType application/wasm               .wasm
AddType application/octet-stream       .data
AddType application/javascript         .js
AddType application/json               .json

# ===========================
# Gzip Precompressed Files
# ===========================

AddEncoding gzip .gz

<FilesMatch "\.wasm\.gz$">
    Header set Content-Type "application/wasm"
    Header set Content-Encoding "gzip"
</FilesMatch>

<FilesMatch "\.js\.gz$">
    Header set Content-Type "application/javascript"
    Header set Content-Encoding "gzip"
</FilesMatch>

<FilesMatch "\.data\.gz$">
    Header set Content-Type "application/octet-stream"
    Header set Content-Encoding "gzip"
</FilesMatch>

# ===========================
# Cache Control (SAFE)
# ===========================

<FilesMatch "\.(wasm|js|data)(\.gz)?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ===========================
# CORS (Unity-safe, restricted)
# ===========================

<FilesMatch "\.(wasm|js|data)(\.gz)?$">
    Header set Access-Control-Allow-Origin "https://5carddraw.net"
</FilesMatch>
